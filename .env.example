# LeetCode credentials (secret — never commit the real .env)
# Browser cookie values from a logged-in leetcode.com session
LEETCODE_SESSION=
CSRFTOKEN=

# Bearer token for /api/agent/* endpoints (optional; generated and persisted
# to DATA_DIR/agent-token on first start if unset)
AGENT_TOKEN=

# Server
PORT=8080
DATA_DIR=/data
